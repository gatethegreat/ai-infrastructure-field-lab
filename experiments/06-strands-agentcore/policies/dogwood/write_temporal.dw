@id("allow_write_after_matching_lookup_and_fresh_single_use_approval")
permit (
    principal,
    action == Drupe::Action::"execute_write",
    resource
)
when temporal {
    formerly within 10m Drupe::Action::"lookup_record"::response{
        output.record_id: context.input.record_id
    }
    && formerly within 5m Drupe::Action::"record_human_approval"::response{
        output.record_id: context.input.record_id,
        output.approval_id: context.input.change.approval_id,
        output.approved: true
    }
    && !Drupe::Action::"execute_write"::response{
        input.record_id: context.input.record_id,
        input.change.approval_id: context.input.change.approval_id,
        output.status: "SUCCEEDED"
    }
       since within 5m Drupe::Action::"record_human_approval"::response{
        output.record_id: context.input.record_id,
        output.approval_id: context.input.change.approval_id,
        output.approved: true
    }
};
